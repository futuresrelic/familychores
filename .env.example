# FamilyChores Environment Variables
# Copy this to .env and fill in your values (never commit .env to git!)

# ============================================
# DATABASE (Future: PostgreSQL for multi-tenant)
# ============================================
# SQLite (current - no config needed)
# PostgreSQL (future - Railway auto-creates DATABASE_URL)
DATABASE_URL=postgresql://user:password@host:5432/familychores

# ============================================
# GOOGLE OAUTH (Phase 3)
# ============================================
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/google/callback

# ============================================
# APPLE SIGN-IN (Phase 3 - required for iOS)
# ============================================
APPLE_CLIENT_ID=com.futuresrelic.familychores
APPLE_TEAM_ID=your-team-id
APPLE_KEY_ID=your-key-id
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour key here\n-----END PRIVATE KEY-----"

# ============================================
# STRIPE PAYMENT (Phase 4)
# ============================================
STRIPE_SECRET_KEY=sk_test_... # Use sk_live_... in production
STRIPE_PUBLISHABLE_KEY=pk_test_... # Use pk_live_... in production
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (create these in Stripe dashboard)
STRIPE_PRICE_FREE=price_free
STRIPE_PRICE_FAMILY=price_1234567890
STRIPE_PRICE_PREMIUM=price_0987654321

# ============================================
# APPLICATION
# ============================================
APP_ENV=production # development, staging, production
APP_URL=https://familychores.com
APP_NAME="FamilyChores"
SESSION_SECRET=generate-a-random-32-character-string

# ============================================
# EMAIL / SMTP (for notifications, password reset)
# ============================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
FROM_EMAIL=noreply@familychores.com
FROM_NAME="FamilyChores"

# Alternative: Postmark, Mailgun, etc.
# POSTMARK_API_KEY=your-postmark-key

# ============================================
# PUSH NOTIFICATIONS (Phase 5)
# ============================================
FIREBASE_SERVER_KEY=your-firebase-cloud-messaging-key
FIREBASE_PROJECT_ID=familychores-12345

# ============================================
# MONITORING & ANALYTICS (Optional)
# ============================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
PLAUSIBLE_DOMAIN=familychores.com

# ============================================
# FEATURE FLAGS (Optional)
# ============================================
ENABLE_REGISTRATIONS=true
ENABLE_GOOGLE_LOGIN=false
ENABLE_STRIPE_BILLING=false
ENABLE_PUSH_NOTIFICATIONS=false
MAINTENANCE_MODE=false

# ============================================
# SECURITY
# ============================================
ALLOWED_ORIGINS=https://familychores.com,https://www.familychores.com
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ============================================
# DEVELOPMENT / DEBUG
# ============================================
DEBUG_MODE=false # NEVER true in production!
LOG_LEVEL=info # debug, info, warning, error
